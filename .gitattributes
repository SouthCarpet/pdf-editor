# Force LF for source files so rustfmt (`newline_style = "Unix"`) passes on
# the Windows CI runner (default `core.autocrlf` rewrites checkouts to CRLF
# otherwise).

*.rs        text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.svg       text eol=lf

# sqlx stores a SHA-384 of each migration's raw bytes in the database and
# refuses a database whose stored value differs. The release was built from
# LF files, so a CRLF checkout built an app that refused every existing
# database. tests/migration_checksums_test.rs locks the released checksums.
*.sql       text eol=lf

# PowerShell scripts are Windows-native — keep CRLF (or whatever)
*.ps1       text
*.psm1      text
*.psd1      text
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary

# Hash-verified vendored OCR assets. services/rapidocr.rs recomputes their
# SHA-256 at load time against a hardcoded registry, so git must not touch a
# single byte. The dictionary is a plain .txt with 502 LFs and no extension
# rule above covers it, so a Windows checkout with the default autocrlf
# rewrote them to CRLF, changed the file length from 1634 bytes, and failed
# the hash check on CI while passing locally where the file was never
# converted. `-text` disables conversion in both directions.
src-tauri/resources/ocr/*.txt    -text
src-tauri/resources/ocr/*.onnx   -text

# Fira Sans files stay byte-identical to the design tree (SHA256SUMS in the folder
# checks them), so git must not convert line endings of OFL.txt or SHA256SUMS.
src/assets/fonts/fira-sans/* -text
