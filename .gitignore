# Rust
target/
**/*.rs.bk
Cargo.lock
# Scratch target dirs from one-off builds. These do not match `target/`, so a
# 1.5 GB one sat untracked and uncovered for three days (found 2026-08-01).
.cargo-target-*/

# Node
node_modules/
dist/
.pnpm-store/

# Tauri
src-tauri/target/
src-tauri/resources/qpdf/
src-tauri/resources/ghostscript/
src-tauri/resources/mupdf/
src-tauri/resources/libreoffice/
src-tauri/resources/tessdata/
src-tauri/resources/tesseract/
src-tauri/resources/pdfcrack/

# iOS/Android icons regenerated by `pnpm tauri icon` but unused on this
# Windows-only personal-use build. Keep PNG/ICO/ICNS + Windows Store sizes.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/gen/

# Sidecar staging stubs (real binaries fetched on demand)
src-tauri/sidecars/*.exe
src-tauri/sidecars/*.dll

# Generated test fixtures (generated by scripts/generate-fixtures.ps1)
src-tauri/tests/fixtures/pdfs/*.pdf
# ...except these six, which are tracked on purpose. generate-fixtures.ps1
# shells out to the real mutool sidecar, and the cargo-test jobs only have
# zero-byte sidecar stubs, so running the generator there fails with "not a
# valid application for this OS platform". The five generated fixtures total
# 28 KB; hodiny.pdf is a fixed regression sample. Tracking them makes tests
# hermetic instead of dependent on a sidecar download.
!src-tauri/tests/fixtures/pdfs/sample.pdf
!src-tauri/tests/fixtures/pdfs/scanned.pdf
!src-tauri/tests/fixtures/pdfs/large.pdf
!src-tauri/tests/fixtures/pdfs/password-open.pdf
!src-tauri/tests/fixtures/pdfs/password-permission.pdf
!src-tauri/tests/fixtures/pdfs/hodiny.pdf
src-tauri/tests/fixtures/docs/*.docx
src-tauri/tests/fixtures/docs/*.odt
src-tauri/tests/fixtures/images/*.png
# ...except word_test.png (1.4 KB): image_to_pdf_test reads it in the plain
# rust-unit job, which never runs generate-fixtures.ps1. Same reasoning as the
# tracked PDFs above. sidecar-contract regenerates it with Ghostscript.
!src-tauri/tests/fixtures/images/word_test.png
src-tauri/tests/fixtures/images/*.jpg

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build outputs
*.msi
*.exe.zip

# TanStack Router route tree — committed so CI/release can tsc-typecheck without
# running Vite first (chicken-and-egg). Vite plugin regenerates it on dev/build,
# but committing the latest snapshot avoids tsc errors on fresh CI checkouts.
# Regen + commit together when adding/removing routes:
#   pnpm dev   # or `pnpm build` — Vite plugin rewrites the file
#   git add src/routeTree.gen.ts && git commit
# src/routeTree.gen.ts

# Local-only dev artifacts
.test-output.txt
.phase12-stash/
.claude/settings.local.json

# tsc composite project incremental + emit
tsconfig.tsbuildinfo
dist-types/

# cargo-fuzz (Phase 18 Task 90c) — runtime state; commit only the harness sources.
src-tauri/fuzz/target/
src-tauri/fuzz/artifacts/
src-tauri/fuzz/corpus/
playwright-report/
test-results/
scripts/vault/autoresearch-results.tsv

# Python __pycache__ from vault hook scripts (Windows)
scripts/hooks/vault/__pycache__/
scripts/vault/__pycache__/

# Playwright verification screenshots from agent runs
output/
