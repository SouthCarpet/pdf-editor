{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main window: dialog, fs (read user-selected PDFs), reveal saved PDFs, shell open.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**/*.pdf" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**/*.pdf" },
        { "path": "**/*.txt" },
        { "path": "**/*.lst" },
        { "path": "**/*.dict" }
      ]
    }
  ]
}
