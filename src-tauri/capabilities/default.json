{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main window: dialog, fs (read user-selected PDFs), shell open.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**/*.pdf" },
        { "path": "**/*.txt" },
        { "path": "**/*.lst" },
        { "path": "**/*.dict" }
      ]
    }
  ]
}
